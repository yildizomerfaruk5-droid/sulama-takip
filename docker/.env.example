# ============================================================
# SULAMA TAKIP — YEREL KURULUM AYARLARI
#
# Bu dosyayi .env olarak KOPYALAMAYIN — kur.sh sizin icin
# rastgele guvenli degerlerle uretir:
#
#     ./kur.sh --eposta yonetici@ornek.com --sifre 'GucluSifre123!'
#
# Elle kuruyorsaniz asagidaki DEGISTIRILMESI ZORUNLU alanlarin
# HEPSINI kendi degerlerinizle doldurun.
#
# ⚠️ GUVENLIK: Bu dosyadaki ornek degerler BILEREK gecersizdir.
#    Supabase'in dokumanlarindaki varsayilan/ornek anahtarlarla
#    ASLA calistirmayin — o anahtarlar herkese aciktir ve sisteminizi
#    ayni agdaki herkese acar.
# ============================================================

# ── DEGISTIRILMESI ZORUNLU ──────────────────────────────────

# Veritabani superuser sifresi. En az 24 karakter, rastgele.
#   uretmek icin:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-32
POSTGRES_SIFRE=DEGISTIR__ornek_deger_kullanmayin

# JWT imzalama sirri. TAM 40+ karakter, rastgele.
# ANON_KEY ve SERVICE_ROLE_KEY bununla imzalanir; degistirirseniz
# ikisini de yeniden uretmeniz gerekir.
#   uretmek icin:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-40
JWT_SECRET=DEGISTIR__ornek_deger_kullanmayin

# JWT_SECRET ile imzalanmis anahtarlar (rol: anon / service_role).
# kur.sh bunlari otomatik uretir. Elle uretmek icin:
#   docs/YEREL_KURULUM.md > "Anahtarlari elle uretmek"
ANON_KEY=DEGISTIR__jwt_uretilmeli
SERVICE_ROLE_KEY=DEGISTIR__jwt_uretilmeli

# Realtime sifreleme anahtari. TAM 16 karakter olmali.
#   uretmek icin:  openssl rand -hex 8
REALTIME_ENC_KEY=DEGISTIR16KARAK

# Realtime oturum sirri. TAM 64 karakter olmali.
#   uretmek icin:  openssl rand -base64 96 | tr -d '/+=' | cut -c1-64
REALTIME_SECRET_KEY_BASE=DEGISTIR__ornek_deger_kullanmayin

# ── AG AYARLARI ─────────────────────────────────────────────

# Cihazin agdaki adresi. mDNS ile sabit kalir (IP degisse bile calisir).
# kur.sh avahi kurup bu adi yayinlar.
GENEL_ADRES=http://sulama.local

# Uygulamanin dinledigi port. 80 = telefonlarda port yazmaya gerek yok.
WEB_PORT=80

# ── ISTEGE BAGLI ────────────────────────────────────────────

# Isletme adi (yalnizca Studio panelinde gorunur)
ISLETME_ADI=Isletme

# Studio paneli portu (yalnizca --profile studio ile acilir)
STUDIO_PORT=3000
